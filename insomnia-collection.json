      "_type": "request",
      "parentId": "wrk_biblioteca",
      "name": "1. Auth - Login",
      "method": "POST",
      "url": "{{ _.baseUrl }}/auth/login",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"admin@biblioteca.com\",\n  \"password\": \"123456\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }]
    },
    {
      "_id": "req_refresh",
      "_type": "request",
      "parentId": "wrk_biblioteca",
